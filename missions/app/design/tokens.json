{
  "$comment": "Shared design tokens. Source of truth for iPhone (ios/OnMission/Shared/Design/Tokens.swift) and web (tokens.css). Look: tomato-flood/prototype.html; spec: tomato-flood/HANDOFF.md and DESIGN.md. The Windows helper still uses the older Mocha look in its own theme files.",
  "name": "Tomato Flood",
  "color": {
    "tomato": "#D2462B",
    "tomatoInk": "#B23A22",
    "cream": "#FBF1E3",
    "ink": "#2E1C16",
    "marigold": "#E8A13A",
    "plum": "#4B3B52",
    "blush": "#F0A58F",
    "rule": "rgba(210,70,43,0.16)",
    "tileRule": "rgba(210,70,43,0.35)",
    "chipRule": "rgba(46,28,22,0.22)",
    "inkSoft": "rgba(46,28,22,0.68)",
    "inkFaint": "rgba(46,28,22,0.55)",
    "creamSoft": "rgba(251,241,227,0.82)",
    "creamFaint": "rgba(251,241,227,0.72)",
    "$use": {
      "tomato": "The flood: poster backgrounds, primary buttons, the active pill, rings, line accents on cream",
      "tomatoInk": "Late and alert text; small tomato text on cream",
      "cream": "Sheets, cream pages, text and line art on tomato",
      "ink": "Text on cream and on marigold",
      "marigold": "The Answered! flood and the Thinking check-in",
      "plum": "The Not now check-in",
      "blush": "The toast's check icon"
    }
  },
  "barModes": {
    "$comment": "The tab bar takes the colour of what sits at the bottom of the screen. Top wins: gold while Answered is up; a pushed page's own mode; the tab's mode.",
    "cream": { "bar": "cream", "icon": "rgba(46,28,22,0.6)", "pill": "tomato", "pillInk": "cream" },
    "flood": { "bar": "tomato", "icon": "rgba(251,241,227,0.72)", "pill": "cream", "pillInk": "tomato" },
    "gold": { "bar": "marigold", "icon": "rgba(46,28,22,0.6)", "pill": "ink", "pillInk": "marigold" }
  },
  "font": {
    "display": "Archivo",
    "hand": "Caveat",
    "$comment": "Archivo is the variable font (wdth 62–125, wght 100–900); Caveat Bold for the handwritten asides. Both OFL, bundled in ios/OnMission/Resources/Fonts.",
    "styles": {
      "disp": { "family": "Archivo", "wdth": 64, "wght": 900, "uppercase": true, "lineHeight": 0.88 },
      "hand": { "family": "Caveat", "wght": 700, "lineHeight": 0.95 },
      "cap": { "family": "Archivo", "wdth": 70, "wght": 800, "size": 21, "tracking": 0.06, "uppercase": true },
      "heroTitle": { "family": "Archivo", "wdth": 78, "wght": 800, "size": 29, "lineHeight": 1.02 },
      "prayer": { "family": "Archivo", "wdth": 80, "wght": 800, "size": 35, "lineHeight": 1.06 },
      "entry": { "family": "Archivo", "wdth": 78, "wght": 800, "size": 36 },
      "kicker": { "family": "Archivo", "wght": 800, "size": 15, "tracking": 0.11, "uppercase": true, "$comment": "15/800 rather than the prototype's 12.5/700 so cream on tomato passes contrast" },
      "section": { "family": "Archivo", "wght": 800, "size": 13, "tracking": 0.13, "uppercase": true },
      "rowTitle": { "family": "Archivo", "wght": 700, "size": 16.5 },
      "rowSub": { "family": "Archivo", "wght": 500, "size": 13 },
      "button": { "family": "Archivo", "wght": 800, "size": 15 },
      "buttonSmall": { "family": "Archivo", "wght": 800, "size": 14 },
      "tab": { "family": "Archivo", "wght": 800, "size": 14.5 }
    },
    "displaySizes": {
      "todayCountdown": 218, "pageNumber": 184, "settingsDate": 150, "newslettersMonth": 140, "allDone": 128,
      "move": 124, "packing": 122, "people": 112, "money": 104, "partnerName": 96, "checkInWord": 90,
      "answered": 74, "readerTitle": 62, "stepNumeral": 46
    }
  },
  "radius": {
    "sheet": 30,
    "tile": 20,
    "docBox": 13,
    "stamp": 8,
    "pill": 999
  },
  "line": {
    "art": 2.4,
    "rule": 1.5,
    "outline": 1.6
  },
  "spacing": {
    "gutter": 24,
    "sheetTop": 22,
    "sheetSide": 20,
    "topBar": 48,
    "air": 20,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24
  },
  "layout": {
    "$comment": "Posters are designed on a 390 × 844 canvas and scale with the phone; the sheet of a pushed page starts at 410.",
    "designWidth": 390,
    "pageSheetTop": 410
  },
  "motion": {
    "$comment": "CSS cubic-bezier control points and durations in seconds. Every moment has a Reduce Motion fallback (HANDOFF.md §9).",
    "flood": { "curve": [0.7, 0, 0.2, 1], "duration": 0.62 },
    "tab": { "curve": [0.3, 1.25, 0.45, 1], "duration": 0.5 },
    "indicator": { "curve": [0.3, 1.3, 0.5, 1], "duration": 0.42 },
    "barFade": { "curve": [0.4, 0, 0.2, 1], "duration": 0.45 },
    "slide": { "curve": [0.2, 0.85, 0.25, 1], "duration": 0.38 },
    "fold": { "curve": [0.4, 0, 0.2, 1], "duration": 0.36 },
    "rise": { "curve": [0.2, 0.8, 0.2, 1], "duration": 0.48, "stagger": 0.05, "distance": 16 },
    "draw": { "curve": [0.6, 0, 0.3, 1], "duration": 0.9, "stagger": 0.055 }
  },
  "icons": {
    "$comment": "Lucide geometry (ISC) with motion ported from lucide-animated by pqoqubbw (MIT). Credited in Settings › About.",
    "tabs": { "today": "sun", "tasks": "list", "people": "users", "prayer": "flame", "move": "plane" }
  },
  "brand": {
    "$comment": "App name chosen 2026-10-11: hesent.me. Read it from here, never hard-code it.",
    "appName": "hesent.me",
    "logo": "logo/app-icon-final.png"
  }
}
