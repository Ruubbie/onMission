<Window x:Class="Missie.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Missie.Desktop.Controls"
        Title="Missie" Icon="Assets/missie.ico"
        Width="1380" Height="880" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource BrandFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,2.5,0">
            <DockPanel Margin="18,22,18,18">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,26">
                    <Grid Width="46" Height="46">
                        <Border Background="{StaticResource Ink}" CornerRadius="9" Margin="4,4,0,0" />
                        <Border Background="{StaticResource Yellow}" BorderBrush="{StaticResource Ink}" BorderThickness="2.5" CornerRadius="9" Margin="0,0,4,4">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Missie" Style="{StaticResource H2}" FontSize="24" />
                        <TextBlock x:Name="TaglineText" Text="Queenstown 2027" Style="{StaticResource MutedText}" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Settings at the bottom -->
                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE713;" Content="Settings" CommandParameter="settings" Checked="OnNavChecked" ToolTip="Ctrl+," />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11.5" Margin="6,6,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,10" Padding="0,0,8,0">
                    <StackPanel x:Name="NavPanel">
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE80F;" Content="Home" CommandParameter="home" Checked="OnNavChecked" ToolTip="Ctrl+1" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE9D5;" Content="Checklists" CommandParameter="checklists" Checked="OnNavChecked" ToolTip="Ctrl+2" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE716;" Content="Partners" CommandParameter="partners" Checked="OnNavChecked" ToolTip="Ctrl+3" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE8C7;" Content="Budget" CommandParameter="budget" Checked="OnNavChecked" ToolTip="Ctrl+4" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE8EC;" Content="Selling" CommandParameter="selling" Checked="OnNavChecked" ToolTip="Ctrl+5" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE7B8;" Content="Packing" CommandParameter="packing" Checked="OnNavChecked" ToolTip="Ctrl+6" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE8A5;" Content="Documents" CommandParameter="documents" Checked="OnNavChecked" ToolTip="Ctrl+7" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE70B;" Content="Notes" CommandParameter="notes" Checked="OnNavChecked" ToolTip="Ctrl+8" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE715;" Content="Newsletter" CommandParameter="newsletter" Checked="OnNavChecked" ToolTip="Ctrl+9" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="&#xE77B;" Content="Contacts" CommandParameter="contacts" Checked="OnNavChecked" ToolTip="Ctrl+0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <DockPanel Margin="32,22,32,10" LastChildFill="True">
                <!-- Sync pill -->
                <Button x:Name="SyncPill" DockPanel.Dock="Right" Style="{StaticResource BrutalButton}" Margin="14,0,0,0" Height="52" Padding="14,0"
                        DataContext="{Binding Sync, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding SyncNowCommand}" ToolTip="{Binding LastError, TargetNullValue='Click to sync now'}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{Binding Dot}" Stroke="{StaticResource Ink}" StrokeThickness="2" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="13.5" />
                            <TextBlock Text="{Binding DetailText}" FontWeight="Normal" FontSize="11.5" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding DetailText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="14" FontWeight="Normal" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource PlusButton}" Width="52" Height="52" FontSize="19" Margin="14,0,0,0"
                        Click="OnNewClick" ToolTip="New item on this page (Ctrl+N)" />

                <!-- Search box (opens the search window) -->
                <Button x:Name="SearchBox" Click="OnSearchClick" Height="52" Cursor="IBeam" HorizontalContentAlignment="Stretch" Padding="14,0" Focusable="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BrutalButton}">
                            <Setter Property="FontWeight" Value="Normal" />
                        </Style>
                    </Button.Style>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource Bg}" Margin="0">
                            <TextBlock Text="Ctrl K" />
                        </Border>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Search everything… tasks, partners, documents, notes" Foreground="{StaticResource Grey}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
            </DockPanel>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="32,6,26,0" Focusable="False" />
        </Grid>
    </Grid>
</Window>
