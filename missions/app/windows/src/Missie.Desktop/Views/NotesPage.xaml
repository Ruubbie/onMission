<UserControl x:Class="Missie.Desktop.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="clr-namespace:Missie.Desktop.Views.Shared"
             xmlns:c="clr-namespace:Missie.Desktop.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Missie;component/Views/Shared/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,8,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Notes" Style="{DynamicResource H1}" />
            <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <sh:ChipBar Grid.Row="1" ItemsSource="{Binding KindChips}" ChipClicked="Chip_Clicked" Margin="0,0,0,6" />

        <DockPanel Grid.Row="2" Margin="0,0,0,14" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="320" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     c:Brutal.Glyph="&#xE721;" c:Brutal.Placeholder="Search…" ToolTip="Search titles and text" />
            <Button DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Content="+  New note" Click="New_Click" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Export CSV…" Click="Export_Click" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Import CSV…" Click="Import_Click" Margin="10,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <c:BrutalCard Padding="8">
                <ListBox x:Name="List" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="10" CornerRadius="4" Background="{Binding KindBrush}" Margin="0,2,10,2"
                                        BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" />
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{DynamicResource MutedText}" Margin="8,0,0,0" />
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE840;" Style="{StaticResource pgGlyph}" FontSize="13" Margin="0,0,6,0"
                                                   Visibility="{Binding Pinned, Converter={StaticResource pgBoolVis}}" ToolTip="Pinned" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Preview}" Style="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" Visibility="{Binding Preview, Converter={StaticResource pgEmptyCollapsed}}" />
                                    <WrapPanel Margin="0,3,0,0">
                                        <Border Style="{StaticResource pgBadge}" Background="{Binding KindBrush}" Padding="6,0" BorderThickness="1.5">
                                            <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <Border Style="{StaticResource pgBadge}" Padding="6,0" BorderThickness="1.5"
                                                Visibility="{Binding Area, Converter={StaticResource pgEmptyCollapsed}}">
                                            <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <Border Style="{StaticResource pgBadge}" Background="{DynamicResource Green}" Padding="6,0" BorderThickness="1.5"
                                                Visibility="{Binding Answered, Converter={StaticResource pgBoolVis}}">
                                            <TextBlock Text="answered" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </c:BrutalCard>

            <!-- Editor -->
            <c:BrutalCard Grid.Column="2" Accent="{Binding Selected.KindBrush}">
                <Grid>
                    <TextBlock Text="Pick a note on the left, or make a new one. Notes are plain Markdown: # heading, **bold**, - list."
                               Style="{StaticResource pgEmptyHint}"
                               Visibility="{Binding HasSelection, Converter={StaticResource pgNotBoolVis}}" />
                    <Grid DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource pgBoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Delay=800}" FontSize="24" FontWeight="Black"
                                 c:Brutal.Placeholder="Title" />

                        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Kind" Style="{StaticResource pgLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{x:Static sh:Lists.NoteKinds}" SelectedItem="{Binding Kind}" Width="140" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Area" Style="{StaticResource pgLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{x:Static sh:Lists.Areas}" SelectedItem="{Binding Area}" Width="150" />
                            </StackPanel>
                            <CheckBox Content="Pinned" IsChecked="{Binding Pinned}" VerticalAlignment="Bottom" Margin="0,0,16,10" />
                            <!-- Prayer notes: you write the prayer; the app only records when it was answered. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                        Visibility="{Binding IsPrayer, Converter={StaticResource pgBoolVis}}">
                                <Button Click="Answered_Click" Margin="0,0,10,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="&#x2713; Mark answered" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Answered}" Value="True">
                                                    <Setter Property="Content" Value="Not answered yet" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding AnsweredText}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" Text="Text (Markdown)" Style="{StaticResource pgLabel}" />
                        <TextBox Grid.Row="3" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource pgMono}" FontSize="14"
                                 SpellCheck.IsEnabled="True" Padding="12,10" />

                        <DockPanel Grid.Row="4" Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource DangerButton}" Content="Delete note" Click="Delete_Click"
                                    VerticalAlignment="Top" Margin="12,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Linked" Style="{StaticResource pgLabel}" Margin="0,0,0,4" />
                                <c:LinkChips Entity="{Binding Model}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Grid>
            </c:BrutalCard>
        </Grid>
    </Grid>
</UserControl>
