<UserControl x:Class="Missie.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Missie.Desktop.Controls"
             xmlns:vm="clr-namespace:Missie.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsPageViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,28">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <TextBlock Text="Everything is stored on this PC first, then synced to your server and iPhone." Style="{StaticResource MutedText}" FontSize="15" Margin="2,6,0,22" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left ===== -->
                <StackPanel>
                    <!-- Account -->
                    <c:BrutalCard Accent="{StaticResource Purple}" FolderTab="True" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Server &amp; account" Style="{StaticResource H3}" />
                            <TextBlock Text="{Binding AccountText}" Style="{StaticResource MutedText}" Margin="0,4,0,16" />

                            <TextBlock Text="Server URL" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ApiUrl}" c:Brutal.Glyph="&#xE774;" c:Brutal.Placeholder="https://api.92-5-233-11.sslip.io" IsReadOnly="{Binding IsLoggedIn}" Margin="0,0,0,14" />

                            <!-- Logged out: login form -->
                            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Email" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" c:Brutal.Placeholder="you@example.nl" Margin="0,0,0,14" />
                                <TextBlock Text="Password" Style="{StaticResource Label}" />
                                <PasswordBox x:Name="Password" Margin="0,0,0,14" />

                                <StackPanel Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Setup secret (from the server's .env, first time only)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SetupSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                                    <TextBlock Text="Your name" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                                </StackPanel>

                                <TextBlock Text="{Binding AccountError}" Foreground="{StaticResource Pink}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Visibility="{Binding AccountError, Converter={StaticResource NullToCollapsed}}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Password}"
                                            IsDefault="False" MinWidth="140">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Log in" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowSetup}" Value="True">
                                                            <Setter Property="Text" Value="Create account" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Busy}" Value="True">
                                                            <Setter Property="Text" Value="Working…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding ToggleSetupCommand}" HorizontalAlignment="Right"
                                            Content="First time? Create account" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Logged in -->
                            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" Orientation="Horizontal">
                                <Button Style="{StaticResource BrutalButton}" Command="{Binding LogoutCommand}" Content="Log out" MinWidth="120" />
                                <TextBlock Text="{Binding AccountError}" Foreground="{StaticResource Pink}" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </c:BrutalCard>

                    <!-- Device & sync -->
                    <c:BrutalCard Accent="{StaticResource Yellow}" FolderTab="True" Padding="22" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="This PC &amp; sync" Style="{StaticResource H3}" Margin="0,0,0,14" />
                            <TextBlock Text="Device name" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding DeviceName}" Margin="0,0,0,16" />
                            <CheckBox IsChecked="{Binding AutoSync}" Content="Sync automatically (on start, every 5 minutes and when you come back)" Margin="0,0,0,18" />
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Command="{Binding Sync.SyncNowCommand}" MinWidth="140">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Sync now" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="11" Height="11" Fill="{Binding Sync.Dot}" Stroke="{StaticResource Ink}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Sync.StateText}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Sync.DetailText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Sync.LastResult}" Style="{StaticResource MutedText}" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Sync.LastError}" Foreground="{StaticResource Pink}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding Sync.LastError, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </c:BrutalCard>
                </StackPanel>

                <!-- ===== Right ===== -->
                <StackPanel Grid.Column="2">
                    <!-- Shared -->
                    <c:BrutalCard Accent="{StaticResource Pink}" FolderTab="True" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Mission settings" Style="{StaticResource H3}" />
                            <TextBlock Text="Shared with your iPhone." Style="{StaticResource MutedText}" Margin="0,4,0,16" />
                            <TextBlock Text="Departure date" Style="{StaticResource Label}" />
                            <DatePicker SelectedDate="{Binding DepartureDate}" Margin="0,0,0,16" HorizontalAlignment="Left" MinWidth="220" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Support minimum / month (€)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SupportMinimum, UpdateSourceTrigger=PropertyChanged}" c:Brutal.Glyph="&#xE8C7;" c:Brutal.Placeholder="750,00" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Support target / month (€)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SupportTarget, UpdateSourceTrigger=PropertyChanged}" c:Brutal.Glyph="&#xE8C7;" c:Brutal.Placeholder="1.000,00" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="NZD per EUR" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding NzdPerEur, UpdateSourceTrigger=PropertyChanged}" c:Brutal.Placeholder="1,85" Width="160" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSharedCommand}" Content="Save" MinWidth="120" />
                                <TextBlock Text="{Binding SharedMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="320" />
                            </StackPanel>
                        </StackPanel>
                    </c:BrutalCard>

                    <!-- Data -->
                    <c:BrutalCard Accent="{StaticResource Green}" FolderTab="True" Padding="22" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Your data" Style="{StaticResource H3}" />
                            <TextBlock Text="{Binding DataDir}" Style="{StaticResource MutedText}" Margin="0,4,0,16" />
                            <WrapPanel>
                                <Button Command="{Binding OpenDataFolderCommand}" Margin="0,0,12,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Open data folder" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportBackupCommand}" Margin="0,0,12,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Export backup…" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenLogCommand}" Content="Open log" Margin="0,0,0,12" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                       Text="Shortcuts: Ctrl+K search · Ctrl+N new · Ctrl+1…0 pages · Ctrl+, settings · F5 sync" />
                        </StackPanel>
                    </c:BrutalCard>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
