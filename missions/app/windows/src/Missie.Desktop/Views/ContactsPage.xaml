<UserControl x:Class="Missie.Desktop.Views.ContactsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Missie.Desktop.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Missie;component/Views/Shared/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,8,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Contacts" Style="{DynamicResource H1}" />
            <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="320" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     c:Brutal.Glyph="&#xE721;" c:Brutal.Placeholder="Search…" ToolTip="Search name, organisation, email, notes" />
            <Button DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Content="+  New contact" Click="New_Click" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Export CSV…" Click="Export_Click" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Import CSV…" Click="Import_Click" Margin="10,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" FrozenColumnCount="1" PreviewKeyDown="Grid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130" />
                    <DataGridTextColumn Header="Organisation" Binding="{Binding Organisation}" Width="150" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>

            <c:BrutalCard Grid.Column="2" Accent="{DynamicResource Sand}">
                <Grid>
                    <TextBlock Text="Select a contact to see notes and what they're linked to." Style="{StaticResource pgEmptyHint}"
                               Visibility="{Binding HasSelection, Converter={StaticResource pgNotBoolVis}}" />
                    <ScrollViewer Style="{StaticResource pgDetailScroll}" Visibility="{Binding HasSelection, Converter={StaticResource pgBoolVis}}">
                        <StackPanel DataContext="{Binding Selected}" Margin="2,0,2,8">
                            <TextBox Text="{Binding Name}" FontSize="22" FontWeight="Black" />
                            <TextBlock Text="Role / organisation" Style="{StaticResource pgLabel}" />
                            <TextBox Text="{Binding Role}" />
                            <TextBox Text="{Binding Organisation}" Margin="0,6,0,0" />
                            <TextBlock Text="Email / phone" Style="{StaticResource pgLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE715;" ToolTip="Write an email"
                                        Click="Mail_Click" Margin="8,0,0,0" />
                                <TextBox Text="{Binding Email}" />
                            </DockPanel>
                            <TextBox Text="{Binding Phone}" Margin="0,6,0,0" />
                            <TextBlock Text="Address" Style="{StaticResource pgLabel}" />
                            <TextBox Text="{Binding Address}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalContentAlignment="Top" />
                            <TextBlock Text="Notes" Style="{StaticResource pgLabel}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=800}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="110" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Linked" Style="{StaticResource pgSectionTitle}" Margin="0,18,0,6" />
                            <c:LinkChips Entity="{Binding Model}" />
                            <Button Style="{DynamicResource DangerButton}" Content="Delete contact" Click="Delete_Click" HorizontalAlignment="Left" Margin="0,22,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </c:BrutalCard>
        </Grid>
    </Grid>
</UserControl>
