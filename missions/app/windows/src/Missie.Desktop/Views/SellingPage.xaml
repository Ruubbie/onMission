<UserControl x:Class="Missie.Desktop.Views.SellingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="clr-namespace:Missie.Desktop.Views.Shared"
             xmlns:c="clr-namespace:Missie.Desktop.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Missie;component/Views/Shared/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,8,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Selling" Style="{DynamicResource H1}" />
            <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <sh:StatTile Label="Items left" Value="{Binding LeftText}" Sub="{Binding AskingText}" Accent="{DynamicResource Pink}" Width="220" />
            <sh:StatTile Label="Sold total" Value="{Binding SoldText}" Sub="sold price (or asking price)" Accent="{DynamicResource Green}" Width="220" />
            <sh:StatTile Label="Online now" Value="{Binding ListedText}" Sub="{Binding PickupText}" Accent="{DynamicResource Yellow}" Width="260" />
        </WrapPanel>

        <sh:ChipBar Grid.Row="2" ItemsSource="{Binding StatusChips}" ChipClicked="Chip_Clicked" Margin="0,0,0,6" />

        <DockPanel Grid.Row="3" Margin="0,0,0,14" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="320" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     c:Brutal.Glyph="&#xE721;" c:Brutal.Placeholder="Search…" ToolTip="Search name, platform, buyer, location" />
            <Button DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Content="+  New item" Click="New_Click" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Export CSV…" Click="Export_Click" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Import CSV…" Click="Import_Click" Margin="10,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" FrozenColumnCount="1" PreviewKeyDown="Grid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="190" />
                    <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBrush}" BorderBrush="{DynamicResource Ink}" BorderThickness="2"
                                        CornerRadius="6" Padding="6,0" Margin="2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static sh:Lists.SellStatuses}" SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Asking €" Binding="{Binding AskingText}" Width="80" />
                    <DataGridTextColumn Header="Sold €" Binding="{Binding SoldText}" Width="80" />
                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="110" />
                    <DataGridTextColumn Header="Listing URL" Binding="{Binding ListingUrl}" Width="150" />
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource IconButton}" Content="&#xE8A7;" ToolTip="Open listing" Click="OpenUrl_Click"
                                        Visibility="{Binding HasUrl, Converter={StaticResource pgBoolVis}}" Padding="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="110" />
                    <DataGridTextColumn Header="Pickup" Binding="{Binding PickupText}" Width="95" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="100" />
                </DataGrid.Columns>
            </DataGrid>

            <c:BrutalCard Grid.Column="2" Accent="{Binding Selected.StatusBrush}">
                <Grid>
                    <TextBlock Text="Select an item to add notes and links. Tip: type sold prices like 45 or 12,50."
                               Style="{StaticResource pgEmptyHint}"
                               Visibility="{Binding HasSelection, Converter={StaticResource pgNotBoolVis}}" />
                    <ScrollViewer Style="{StaticResource pgDetailScroll}" Visibility="{Binding HasSelection, Converter={StaticResource pgBoolVis}}">
                        <StackPanel DataContext="{Binding Selected}" Margin="2,0,2,8">
                            <TextBox Text="{Binding Name}" FontSize="22" FontWeight="Black" />
                            <TextBlock Text="Status" Style="{StaticResource pgLabel}" />
                            <ComboBox ItemsSource="{x:Static sh:Lists.SellStatuses}" SelectedItem="{Binding Status}" />
                            <TextBlock Text="Pickup date" Style="{StaticResource pgLabel}" />
                            <DatePicker SelectedDate="{Binding PickupDate}" />
                            <TextBlock Text="Listing" Style="{StaticResource pgLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE8A7;" ToolTip="Open listing"
                                        Click="OpenUrl_Click" Margin="8,0,0,0" />
                                <TextBox Text="{Binding ListingUrl}" />
                            </DockPanel>
                            <TextBlock Text="Notes" Style="{StaticResource pgLabel}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=800}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="110" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Linked" Style="{StaticResource pgSectionTitle}" Margin="0,18,0,6" />
                            <c:LinkChips Entity="{Binding Model}" />
                            <Button Style="{DynamicResource DangerButton}" Content="Delete item" Click="Delete_Click" HorizontalAlignment="Left" Margin="0,22,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </c:BrutalCard>
        </Grid>
    </Grid>
</UserControl>
