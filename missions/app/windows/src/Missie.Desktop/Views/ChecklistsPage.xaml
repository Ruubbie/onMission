<UserControl x:Class="Missie.Desktop.Views.ChecklistsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Missie.Desktop.Controls"
             xmlns:vm="clr-namespace:Missie.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChecklistsPageViewModel}">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: checklists ===== -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Background="{StaticResource Yellow}" Content="&#xE710;"
                        Command="{Binding NewChecklistCommand}" ToolTip="New checklist" />
                <TextBlock Text="Checklists" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,10">
                <ItemsControl ItemsSource="{Binding Lists}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChecklistEntry}">
                            <c:FolderCard Style="{StaticResource FolderRow}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" Glyph="{Binding Glyph}"
                                          Accent="{Binding Accent}" IsSelected="{Binding IsSelected}"
                                          Command="{Binding DataContext.SelectListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ===== Right: tasks ===== -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <!-- Title -->
                <TextBlock Text="All tasks" Style="{StaticResource H1}" Visibility="{Binding IsAll, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Text="{Binding ListTitle}" Style="{StaticResource InlineTextBox}" FontFamily="{StaticResource HeadingFont}" FontSize="40"
                         Margin="-4,0,0,0" Visibility="{Binding IsAll, Converter={StaticResource InverseBoolToVisibility}}" ToolTip="Click to rename" />
                <TextBox Text="{Binding ListDescription}" Style="{StaticResource InlineTextBox}" FontWeight="Normal" FontSize="14" Foreground="{StaticResource Muted}"
                         TextWrapping="Wrap" AcceptsReturn="False" Margin="-4,2,0,0"
                         Visibility="{Binding IsAll, Converter={StaticResource InverseBoolToVisibility}}" ToolTip="Description (click to edit)" />

                <!-- Toolbar -->
                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,4" />
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource ChipButton}" IsChecked="{Binding ShowDone}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Show done" />
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsAll, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Area" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AreaOptions}" SelectedItem="{Binding ListArea}" Width="140" Margin="0,0,14,0" />
                        <TextBlock Text="Phase" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding PhaseOptions}" SelectedItem="{Binding ListPhase}" Width="170" Margin="0,0,14,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE7B8;" Command="{Binding ArchiveChecklistCommand}" ToolTip="Archive checklist" Margin="0,0,10,0" />
                        <Button Style="{StaticResource IconButton}" Background="{StaticResource Pink}" Content="&#xE74D;" Command="{Binding DeleteChecklistCommand}" ToolTip="Delete checklist" />
                    </StackPanel>
                </DockPanel>

                <!-- Add a task -->
                <Grid Margin="0,16,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTaskBox" Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}" MinHeight="52" FontSize="15"
                             c:Brutal.Glyph="#" c:Brutal.Placeholder="Add a task…   ! = important, #visa = area, fri / 12/11 = due">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource PlusButton}" Width="52" Height="52" Margin="14,0,0,0" Command="{Binding AddTaskCommand}" ToolTip="Add task" />
                </Grid>
            </StackPanel>

            <!-- Task list -->
            <ScrollViewer x:Name="TaskScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,20">
                <StackPanel>
                    <TextBlock Text="Nothing here yet. Add the first task above." Style="{StaticResource MutedText}" FontSize="15" Margin="4,10"
                               Visibility="{Binding Tasks.Count, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl x:Name="TaskList" ItemsSource="{Binding TasksView}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                            <Border Style="{StaticResource Chip}" Background="{Binding Name, Converter={StaticResource AccentFromKey}}" Padding="12,3,12,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource GlyphFromKey}}" FontFamily="{StaticResource IconFont}" FontWeight="Normal"
                                                               FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} tasks}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskRow}">
                                <c:BrutalCard x:Name="Card" Padding="12,8,10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsDone}" VerticalAlignment="Center" ToolTip="Done" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Pink}" FontSize="14" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" ToolTip="Important" Visibility="{Binding IsHigh, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" ToolTip="Has notes" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                                <Border x:Name="StatusChip" Style="{StaticResource Chip}" Background="{Binding StatusAccent}" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding Status}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Background="{Binding Area, Converter={StaticResource AccentFromKey}}"
                                                        Visibility="{Binding Area, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock Text="{Binding Area}" />
                                                </Border>
                                                <Border x:Name="DueChip" Style="{StaticResource Chip}" Background="{StaticResource Sand}"
                                                        Visibility="{Binding DueText, Converter={StaticResource NullToCollapsed}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" FontSize="10" Margin="0,1,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DueText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE70E;" Margin="6,0,4,0" ToolTip="Move up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE70D;" Margin="0,0,4,0" ToolTip="Move down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button x:Name="ExpandButton" Style="{StaticResource SmallIconButton}" Content="&#xE712;" ToolTip="Details"
                                                        Command="{Binding ToggleExpandedCommand}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                                <TextBox x:Name="TitleBox" Text="{Binding Title}" Style="{StaticResource InlineTextBox}" />
                                                <TextBlock Text="{Binding ChecklistTitle}" Style="{StaticResource MutedText}" FontSize="12" Margin="4,0,0,0"
                                                           Visibility="{Binding ChecklistTitle, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Details -->
                                        <Grid Margin="38,14,8,8" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,0,0,14">
                                                <TextBlock Text="Status" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                                <RadioButton Style="{StaticResource SegmentButton}" Content="To do" IsChecked="{Binding IsTodo}" />
                                                <RadioButton Style="{StaticResource SegmentButton}" Content="Doing" IsChecked="{Binding IsDoing}" />
                                                <RadioButton Style="{StaticResource SegmentButton}" Content="Waiting" IsChecked="{Binding IsWaiting}" />
                                                <RadioButton Style="{StaticResource SegmentButton}" Content="Done" IsChecked="{Binding IsDone}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="Due" Style="{StaticResource Label}" />
                                                <DatePicker SelectedDate="{Binding DueDate}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                                <TextBlock Text="Priority" Style="{StaticResource Label}" />
                                                <ComboBox ItemsSource="{x:Static vm:TaskRow.PriorityOptions}" SelectedItem="{Binding Priority}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,14">
                                                <TextBlock Text="Area" Style="{StaticResource Label}" />
                                                <ComboBox ItemsSource="{x:Static vm:TaskRow.AreaOptions}" SelectedItem="{Binding Area}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="Waiting on" Style="{StaticResource Label}" />
                                                <TextBox Text="{Binding WaitingOn}" c:Brutal.Placeholder="Who / what?" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                                <TextBlock Text="Link (web page)" Style="{StaticResource Label}" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="10,0,0,0"
                                                            Command="{Binding OpenUrlCommand}" IsEnabled="{Binding HasUrl}" ToolTip="Open in browser" />
                                                    <TextBox Text="{Binding SourceUrl}" c:Brutal.Placeholder="https://…" />
                                                </DockPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Margin="0,0,0,14">
                                                <TextBlock Text="Notes" Style="{StaticResource Label}" />
                                                <TextBox Style="{StaticResource BrutalTextArea}" Text="{Binding Notes}" c:Brutal.Placeholder="Details, steps, phone numbers…" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="4" Grid.ColumnSpan="5" Margin="0,0,0,8">
                                                <TextBlock Text="Linked" Style="{StaticResource Label}" />
                                                <c:LinkChips Entity="{Binding Model}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="5" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource DangerButton}" MinHeight="38" Padding="14,4"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="Delete task" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </c:BrutalCard>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter TargetName="DueChip" Property="Background" Value="{StaticResource Pink}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="TitleBox" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="TitleBox" Property="Foreground" Value="{StaticResource Muted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDoing}" Value="True">
                                        <Setter TargetName="StatusChip" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                        <Setter TargetName="StatusChip" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="ExpandButton" Property="Content" Value="&#xE70E;" />
                                        <Setter TargetName="ExpandButton" Property="Background" Value="{StaticResource Yellow}" />
                                        <Setter TargetName="Card" Property="Accent" Value="{StaticResource Yellow}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
