<Window x:Class="Missie.Desktop.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Missie.Desktop.Controls"
        xmlns:vm="clr-namespace:Missie.Desktop.ViewModels"
        Title="Search" Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}" Foreground="{StaticResource Ink}" FontSize="14"
        d:DataContext="{d:DesignInstance vm:SearchWindowViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <c:BrutalCard Margin="14" Padding="22" Accent="{StaticResource Yellow}" FolderTab="True">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="Esc" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Text="Find anything." Style="{StaticResource H2}" />
            </DockPanel>
            <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="18" MinHeight="56" Margin="0,10,0,0"
                     c:Brutal.Placeholder="Tasks, partners, documents, notes…" c:Brutal.Glyph="&#xE721;" PreviewKeyDown="OnQueryKeyDown" />
            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="2,12,0,6" />
            <ListBox x:Name="ResultList" ItemsSource="{Binding ResultsView}" SelectedItem="{Binding Selected}" MaxHeight="460"
                     MouseDoubleClick="OnResultDoubleClick" KeyDown="OnListKeyDown"
                     Visibility="{Binding Results.Count, Converter={StaticResource NullToCollapsed}}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="6,10,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchResultItem}">
                        <DockPanel>
                            <Border Width="34" Height="34" CornerRadius="7" Background="{Binding Accent}" BorderBrush="{StaticResource Ink}" BorderThickness="2">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Snippet, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </c:BrutalCard>
</Window>
