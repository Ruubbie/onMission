<UserControl x:Class="Missie.Desktop.Views.Shared.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinWidth="170">
    <!-- Big number tile with a hard shadow. -->
    <Grid Margin="0,0,16,16">
        <Border Background="{DynamicResource Ink}" CornerRadius="12" Margin="6,6,-6,-6" />
        <Border Background="{Binding Accent, ElementName=Root}" BorderBrush="{DynamicResource Ink}" BorderThickness="3"
                CornerRadius="12" Padding="18,12,18,14">
            <StackPanel>
                <TextBlock Text="{Binding Label, ElementName=Root}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="{Binding Value, ElementName=Root}" FontWeight="Black" FontSize="30" Margin="0,2,0,0"
                           Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub, ElementName=Root}" FontSize="12" FontWeight="SemiBold" Opacity="0.75"
                           Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
