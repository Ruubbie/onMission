<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:Missie.Desktop.Controls"
                    xmlns:t="clr-namespace:Missie.Desktop.Theme">
    <!--
      Neo-brutalist design system for Missie.
      Cream page, paper cards, thick ink outlines, HARD offset shadows (a second ink Border behind, never a blur),
      bold grotesk headings, chunky buttons that press in.
      Palette, radii and accent map = missions/app/design/tokens.json (Theme/Converters.cs Look has the same values in code).
    -->

    <!-- ===== Colours ===== -->
    <Color x:Key="BgColor">#FBF6EA</Color>
    <Color x:Key="PaperColor">#FFFDF7</Color>
    <Color x:Key="InkColor">#111111</Color>
    <Color x:Key="MutedColor">#6E6A60</Color>
    <Color x:Key="YellowColor">#FFD21F</Color>
    <Color x:Key="PinkColor">#FF4F7B</Color>
    <Color x:Key="GreenColor">#2DBE4E</Color>
    <Color x:Key="LimeColor">#A4E22F</Color>
    <Color x:Key="PurpleColor">#7B61FF</Color>
    <Color x:Key="SandColor">#FFE08A</Color>
    <Color x:Key="GreyColor">#9A9A9A</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Lime" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="Sand" Color="{StaticResource SandColor}" />
    <SolidColorBrush x:Key="Grey" Color="{StaticResource GreyColor}" />
    <!-- Extra helpers -->
    <SolidColorBrush x:Key="SoftYellow" Color="#FFF3C4" />
    <SolidColorBrush x:Key="SoftPink" Color="#FFE1E8" />
    <SolidColorBrush x:Key="Hairline" Color="#E4DCC8" />
    <SolidColorBrush x:Key="AltRow" Color="#FFF9EC" />

    <!-- ===== Fonts & metrics ===== -->
    <FontFamily x:Key="BrandFont">../Fonts/#Familjen Grotesk, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFont">../Fonts/#Familjen Grotesk, Segoe UI Black, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Thickness x:Key="Outline">2.5</Thickness>
    <Thickness x:Key="ShadowMargin">5,5,0,0</Thickness>
    <Thickness x:Key="FaceMargin">0,0,5,5</Thickness>
    <CornerRadius x:Key="Radius">10</CornerRadius>
    <CornerRadius x:Key="SmallRadius">7</CornerRadius>

    <!-- ===== Converters ===== -->
    <t:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <t:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <t:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <t:NullToCollapsedConverter x:Key="NullToVisible" Invert="True" />
    <t:CentsToEuroConverter x:Key="CentsToEuro" />
    <t:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    <t:AccentFromKeyConverter x:Key="AccentFromKey" />
    <t:GlyphFromKeyConverter x:Key="GlyphFromKey" />

    <!-- ===== Text ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="LineHeight" Value="50" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Small coloured pill tag: <Border Style="{StaticResource Chip}" Background="{StaticResource Lime}"><TextBlock Text="visa"/></Border> -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Sand}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource Purple}" BorderThickness="2" CornerRadius="12" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="BrutalButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" />
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}"
                    Margin="0,0,4,4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="-1,-1,5,5" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="4,4,0,0" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Yellow}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                <Setter TargetName="Face" Property="Margin" Value="0,0,4,4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BrutalButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource BrutalButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BrutalButton}" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BrutalButton}">
        <Setter Property="Background" Value="{StaticResource Yellow}" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BrutalButton}">
        <Setter Property="Background" Value="{StaticResource Pink}" />
    </Style>
    <!-- Square icon button; Content is a glyph string, e.g. Content="&#xE713;" -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BrutalButton}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Smaller square icon button for list rows. -->
    <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
    </Style>
    <!-- Big yellow "+" (the screenshot's add button). -->
    <Style x:Key="PlusButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{StaticResource Yellow}" />
        <Setter Property="Content" Value="&#xE710;" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="58" />
    </Style>
    <!-- Text-only button without outline, for minor actions. -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Sand}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Chip-shaped clickable button (used by LinkChips, filters). -->
    <Style x:Key="ChipButton" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border Background="{StaticResource Ink}" CornerRadius="999" Margin="2,2,0,0" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ink}" BorderThickness="2"
                                CornerRadius="999" Margin="0,0,2,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Yellow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="2,2,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Segmented toggle (RadioButton) for status pickers / filters: style a RadioButton with this. -->
    <Style x:Key="SegmentButton" TargetType="RadioButton" BasedOn="{StaticResource ChipButton}" />

    <!-- Sidebar navigation item: RadioButton with Tag = glyph, Content = label. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Height="46">
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" Visibility="Hidden" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2.5"
                                CornerRadius="{StaticResource Radius}" Margin="0,0,4,4" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="IconBox" Width="28" Height="28" CornerRadius="6" BorderBrush="{StaticResource Ink}" BorderThickness="2" Background="{StaticResource Paper}">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="14" FontWeight="Normal"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="12,0,0,1" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Yellow}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ink}" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="4,4,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="BrutalTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Yellow}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" Margin="0,0,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="{Binding (c:Brutal.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding (c:Brutal.Glyph), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{Binding (c:Brutal.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource Grey}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="White" />
                            <Setter TargetName="Shadow" Property="Background" Value="{StaticResource Purple}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Bg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Shadow" Property="Background" Value="{StaticResource Pink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource BrutalTextBox}" />
    <!-- Multi-line text (notes, bodies). -->
    <Style x:Key="BrutalTextArea" TargetType="TextBox" BasedOn="{StaticResource BrutalTextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="90" />
        <Setter Property="SpellCheck.IsEnabled" Value="True" />
    </Style>
    <!-- Borderless inline editor (titles in lists): looks like text until hovered/focused. -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Yellow}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Hairline}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ink}" />
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrutalPasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Yellow}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" Margin="0,0,4,4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="White" />
                            <Setter TargetName="Shadow" Property="Background" Value="{StaticResource Purple}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource BrutalPasswordBox}" />

    <!-- ComboBox -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BrutalComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Yellow}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource BrutalComboBoxItem}" />

    <Style x:Key="BrutalComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="12,8,34,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" Margin="0,0,4,4" />
                        <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="10,0,34,4" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" Focusable="True" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"
                                 FontWeight="{TemplateBinding FontWeight}" />
                        <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}" Margin="0,0,4,4"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None" VerticalOffset="2">
                            <Grid MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" />
                                <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="2.5"
                                        CornerRadius="{StaticResource Radius}" Margin="0,0,4,4" Padding="3">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" TextElement.FontWeight="Normal" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Toggle" Property="Width" Value="36" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Shadow" Property="Background" Value="{StaticResource Purple}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource BrutalComboBox}" />

    <!-- CheckBox: chunky square with a hard shadow. -->
    <Style x:Key="BrutalCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="27" Height="27" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border Background="{StaticResource Ink}" CornerRadius="6" Margin="3,3,0,0" />
                            <Border x:Name="Box" Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}" BorderThickness="2.5"
                                    CornerRadius="6" Margin="0,0,3,3">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="Text" Grid.Column="1" Margin="10,0,0,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Green}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Sand}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Margin" Value="3,3,0,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Purple}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource BrutalCheckBox}" />

    <!-- DatePicker: outlined, ink text. -->
    <Style x:Key="BrutalDatePicker" TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6,7" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="FirstDayOfWeek" Value="Monday" />
        <Style.Resources>
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Style.Resources>
    </Style>
    <Style TargetType="DatePicker" BasedOn="{StaticResource BrutalDatePicker}" />

    <!-- ===== DataGrid ===== -->
    <Style x:Key="BrutalDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="0,0,0,2.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock x:Name="Sort" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Sort" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Sort" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Sort" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Sort" Property="Text" Value="&#xE70D;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BrutalDataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="B" Property="Background" Value="White" />
                            <Setter TargetName="B" Property="Padding" Value="4,2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BrutalDataGridRow" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SoftYellow}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Sand}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BrutalDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="RowBackground" Value="{StaticResource Paper}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource AltRow}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Hairline}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="MinRowHeight" Value="42" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource BrutalDataGridColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource BrutalDataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource BrutalDataGridRow}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="5,5,0,0" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}"
                                Margin="0,0,5,5" Padding="3">
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Column="1"
                                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.ColumnSpan="2"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="2" Orientation="Vertical"
                                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                            <Grid Grid.Row="2" Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                                                           Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                           Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                                            </Grid>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- Editing elements inside cells stay flat (no shadow). -->
            <Style TargetType="TextBox">
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="2,4" />
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
                <Setter Property="SelectionBrush" Value="{StaticResource Yellow}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource BrutalComboBox}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="6,4,30,4" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource BrutalCheckBox}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource SandColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource SandColor}" />
        </Style.Resources>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource BrutalDataGrid}" />

    <!-- ===== ScrollBar (slim, ink thumb) ===== -->
    <Style x:Key="BrutalScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource Ink}" CornerRadius="5" Opacity="0.55" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource BrutalScrollThumb}" MinHeight="30" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,2">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource BrutalScrollThumb}" MinWidth="30" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Ink}" />
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ListBox: transparent list without the blue selection. -->
    <Style x:Key="BrutalListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Yellow}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BrutalListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BrutalListBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource BrutalListBox}" />

    <!-- ===== Custom controls ===== -->
    <Style TargetType="c:BrutalCard">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="{StaticResource Outline}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:BrutalCard">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Folder tab sticks out above the card, behind its outline. -->
                        <Path x:Name="Tab" Grid.Row="0" Height="17" Width="130" HorizontalAlignment="Left" Margin="12,0,0,-3"
                              Data="M0,1 L0,0.25 Q0,0 0.06,0 L0.84,0 Q0.88,0 0.9,0.12 L1,1 Z" Stretch="Fill"
                              Fill="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={StaticResource Grey}}"
                              Stroke="{StaticResource Ink}" StrokeThickness="2.5" Visibility="Collapsed" />
                        <Border Grid.Row="1" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="5,5,0,0" />
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" Margin="0,0,5,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Strip" Height="8" CornerRadius="7,7,0,0" Visibility="Collapsed"
                                        Background="{TemplateBinding Accent}" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2.5" />
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="FolderTab" Value="True">
                            <Setter TargetName="Tab" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="FolderTab" Value="False" />
                                <Condition Property="HasAccent" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Strip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:FolderCard">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Accent" Value="{StaticResource Grey}" />
        <Setter Property="Glyph" Value="&#xE8B7;" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:FolderCard">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Path x:Name="Tab" Height="18" Width="140" HorizontalAlignment="Left" Margin="12,0,0,-3"
                              Data="M0,1 L0,0.25 Q0,0 0.06,0 L0.84,0 Q0.88,0 0.9,0.12 L1,1 Z" Stretch="Fill"
                              Fill="{TemplateBinding Accent}" Stroke="{StaticResource Ink}" StrokeThickness="2.5" />
                        <Border Grid.Row="1" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="6,6,0,0" />
                        <Border x:Name="Face" Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2.5" CornerRadius="{StaticResource Radius}" Margin="0,0,6,6" Padding="16,16,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="7" Background="{TemplateBinding Accent}" BorderBrush="{StaticResource Ink}" BorderThickness="2.5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{TemplateBinding Subtitle}" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" />
                                        <Border x:Name="BadgeBox" Background="{StaticResource Pink}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="{TemplateBinding Badge}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{TemplateBinding Detail}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Text="{TemplateBinding Title}"
                                           FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" />
                                <Border x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,12,0,0" VerticalAlignment="Bottom"
                                        BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="4" Background="{StaticResource Bg}">
                                    <ProgressBar Value="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}}" Maximum="1" BorderThickness="0"
                                                 Background="Transparent" Foreground="{TemplateBinding Accent}" Height="4" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="-1,-1,7,7" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="6,6,0,0" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="Progress" Value="{x:Null}">
                            <Setter TargetName="Progress" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasBadge" Value="True">
                            <Setter TargetName="BadgeBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact one-line folder row for side lists (Checklists page). -->
    <Style x:Key="FolderRow" TargetType="c:FolderCard">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Accent" Value="{StaticResource Grey}" />
        <Setter Property="Glyph" Value="&#xE8B7;" />
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:FolderCard">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="{StaticResource Radius}" Margin="4,4,0,0" Visibility="Hidden" />
                        <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="2.5"
                                CornerRadius="{StaticResource Radius}" Margin="0,0,4,4" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{TemplateBinding Accent}" BorderBrush="{StaticResource Ink}" BorderThickness="2.5">
                                    <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Title}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{TemplateBinding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12.5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SoftYellow}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Paper}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ink}" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="4,4,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBar: ink outline, flat fill. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
